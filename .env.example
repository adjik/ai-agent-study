# DeepSeek API Key
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 阶段 4：内网 Redis（向量库 + 会话记忆）
# 不装本地服务，直接用已有内网实例。密码不入库。
REDIS_HOST=10.0.0.12
REDIS_PORT=6379
REDIS_PASSWORD=your-password-here
REDIS_DB=0

# A = 向量存 Redis（需要 RediSearch + RedisJSON）
# B = 向量落 demos/04-rag/vector-data/index.json，Redis 只存记忆
STAGE04_VECTOR_MODE=A
